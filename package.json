{
  "name": "mathracing",
  "version": "1.0.0",
  "private": true,
  "description": "MathRacing - offline-first, 2-5 player, KPM-aligned mathematics racing game for Malaysian Year 1 and Year 2 classrooms.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "docs:curriculum": "node scripts/gen-curriculum-doc.mjs",
    "docs:map": "node scripts/gen-repo-map.mjs",
    "docs:agents": "node scripts/check-agents.mjs",
    "check:fast": "node scripts/check-fast.mjs",
    "check": "npm run docs:agents && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
